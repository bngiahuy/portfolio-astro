---
import { getSiteConfig } from "../config";
const siteConfig = getSiteConfig(Astro.url.pathname);
const hasProjects = siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
        <div class="lg:col-span-4">
          <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
            {siteConfig.labels.projects}
          </h2>
          <div
            class="w-[75px] h-[5px] mt-2 rounded-full"
            style={{ backgroundColor: siteConfig.accentColor }}
          />
        </div>

        <div class="lg:col-span-8 space-y-6">
          {siteConfig.projects.map((project, index) => {
            const linkLabel = project.linkLabel || siteConfig.labels.externalLink;
            return (
              <article class="rounded-xl border border-gray-200 bg-gray-50 p-4 sm:p-6 md:p-8">
                <div class="flex flex-col gap-4">
                  <div>
                    <span class="text-sm font-mono" style={{ color: siteConfig.accentColor }}>
                      0{index + 1}
                    </span>
                    <h3 class="mt-1 text-xl sm:text-2xl font-bold text-gray-900">
                      {project.name}
                    </h3>
                    <p class="mt-2 text-base text-gray-600 leading-relaxed">
                      {project.summary}
                    </p>
                  </div>
                  {project.link && (
                    <a
                      href={project.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={linkLabel + ": " + project.name + ". " + siteConfig.labels.newTab}
                      class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-semibold text-gray-800 hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2"
                    >
                      {linkLabel}
                      <svg aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
                      </svg>
                    </a>
                  )}
                </div>

                <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
                  <div>
                    <h4 class="text-xs font-semibold uppercase tracking-wide text-gray-500">{siteConfig.labels.problem}</h4>
                    <p class="mt-1 text-sm leading-relaxed text-gray-700">{project.problem}</p>
                  </div>
                  <div>
                    <h4 class="text-xs font-semibold uppercase tracking-wide text-gray-500">{siteConfig.labels.role}</h4>
                    <p class="mt-1 text-sm leading-relaxed text-gray-700">{project.role}</p>
                  </div>
                  <div>
                    <h4 class="text-xs font-semibold uppercase tracking-wide text-gray-500">{siteConfig.labels.outcome}</h4>
                    <p class="mt-1 text-sm leading-relaxed text-gray-700">{project.outcome}</p>
                  </div>
                  {project.constraints && project.constraints.length > 0 && (
                    <div>
                      <h4 class="text-xs font-semibold uppercase tracking-wide text-gray-500">{siteConfig.labels.constraints}</h4>
                      <ul class="mt-1 space-y-1 text-sm leading-relaxed text-gray-700">
                        {project.constraints.map((constraint) => <li>{constraint}</li>)}
                      </ul>
                    </div>
                  )}
                </div>

                {project.skills.length > 0 && (
                  <div class="mt-6 border-t border-gray-200 pt-4">
                    <h4 class="text-xs font-semibold uppercase tracking-wide text-gray-500">{siteConfig.labels.technologies}</h4>
                    <ul class="mt-2 flex flex-wrap gap-2">
                      {project.skills.map((skill) => (
                        <li class="rounded-md bg-gray-900 px-2.5 py-1 text-xs sm:text-sm font-medium text-white">
                          {skill}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )
}
