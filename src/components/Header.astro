---
import { getSiteConfig } from "../config";
const siteConfig = getSiteConfig(Astro.url.pathname);

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 block transition-all duration-300"
>
  <nav class="max-w-7xl mx-auto px-3 sm:px-6 md:px-8 py-2 md:py-4">
    <ul class="flex flex-wrap items-center gap-x-1 sm:gap-x-4 md:gap-8 justify-center">
      <li>
        <a
          href="#about"
          class="inline-flex min-h-11 items-center rounded px-1 text-xs sm:text-sm md:text-base text-gray-700 hover:text-black transition-colors font-medium focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          {siteConfig.labels.about}
        </a>
      </li>
      {
        hasProjects && (
          <li>
            <a
              href="#projects"
              class="inline-flex min-h-11 items-center rounded px-1 text-xs sm:text-sm md:text-base text-gray-700 hover:text-black transition-colors font-medium focus-visible:outline-2 focus-visible:outline-offset-2"
            >
              {siteConfig.labels.projects}
            </a>
          </li>
        )
      }
      {
        hasExperience && (
          <li>
            <a
              href="#experience"
              class="inline-flex min-h-11 items-center rounded px-1 text-xs sm:text-sm md:text-base text-gray-700 hover:text-black transition-colors font-medium focus-visible:outline-2 focus-visible:outline-offset-2"
            >
              {siteConfig.labels.experience}
            </a>
          </li>
        )
      }
      {
        hasEducation && (
          <li>
            <a
              href="#education"
              class="inline-flex min-h-11 items-center rounded px-1 text-xs sm:text-sm md:text-base text-gray-700 hover:text-black transition-colors font-medium focus-visible:outline-2 focus-visible:outline-offset-2"
            >
              {siteConfig.labels.education}
            </a>
          </li>
        )
      }
      <li>
        <a
          href={siteConfig.blogUrl}
          class="inline-flex min-h-11 items-center rounded px-1 text-xs sm:text-sm md:text-base text-gray-700 hover:text-black transition-colors font-medium focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          {siteConfig.labels.blog}
        </a>
      </li>
      <li>
        <a href={siteConfig.alternatePath} class="inline-flex min-h-11 items-center rounded px-1 text-xs sm:text-sm md:text-base text-gray-700 hover:text-black transition-colors font-medium focus-visible:outline-2 focus-visible:outline-offset-2">
          {siteConfig.alternateLabel}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  window.addEventListener("scroll", () => {
    const header = document.getElementById("header");
    if (window.scrollY > 100) {
      header?.classList.add("bg-white/80", "backdrop-blur-sm");
    } else {
      header?.classList.remove("bg-white/80", "backdrop-blur-sm");
    }
  });
</script>
